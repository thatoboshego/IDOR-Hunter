# IDOR Hunter Security Lab - environment configuration template.
# Copy this file to `.env` and fill in real values ONLY if you intend to
# enable real Twilio phone-call alerts. Never commit a real `.env` file.

# ----- Administrator alert phone number -----
# The number the retry scheduler will "call" (or really call, with Twilio).
ADMIN_PHONE_NUMBER=+10000000000

# ----- Twilio (optional, real telephony alerts) -----
# Leave blank / unset to keep using the default mock telephony provider,
# which never makes a network call. To enable real calls:
#   1. Create a Twilio account and a Programmable Voice-capable number.
#   2. Set idorhunter.alerts.provider=twilio (e.g. via SPRING_APPLICATION_JSON
#      or --idorhunter.alerts.provider=twilio) when starting the app.
#   3. Populate the three variables below.
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=
